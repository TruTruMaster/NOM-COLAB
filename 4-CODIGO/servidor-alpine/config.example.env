# servidor-alpine (Raspberry Pi 5) settings. Copy to config.env and edit it
# BEFORE building the kernel: Wi-Fi and USB decide what goes into it.
# Plain sh syntax: NAME="value". Secrets (Wi-Fi password, Tailscale key) are
# used while writing the card and never stored on it as text.

# ------------------------------------------------------------------ system
SERVER_NAME="pi5"           # hostname, and the machine name in Tailscale
TIMEZONE="UTC"              # e.g. "America/Mexico_City", "Europe/Madrid"
ADMIN_USER="admin"

# ------------------------------------------------------------------ SSH
# Your laptop's public key(s), one per line:  cat ~/.ssh/id_ed25519.pub
# (none yet? ssh-keygen -t ed25519)
SSH_KEYS="
"

# ------------------------------------------------------------------ network
# Ethernet (eth0, DHCP) is always on. Leave WIFI_SSID empty to keep Wi-Fi and
# Bluetooth out of the kernel and powered off.
WIFI_SSID=""
WIFI_PSK=""
WIFI_COUNTRY=""             # two letters, required with Wi-Fi (e.g. "MX", "US")

# ------------------------------------------------------------------ Tailscale
# An auth key from https://login.tailscale.com/admin/settings/keys joins the
# tailnet on first boot. Empty: run `doas tailscale up --qr` over SSH (LAN).
TS_AUTHKEY=""
TS_ACCEPT_DNS="no"          # "yes" lets Tailscale rewrite /etc/resolv.conf (MagicDNS)

# ------------------------------------------------------------------ website
# Folder on this laptop with your static site (index.html at its top). Copied
# to /srv/www/default on the card. Empty: a placeholder page.
SITE_DIR=""

# ------------------------------------------------------------------ power, kernel
CPU_GOVERNOR="schedutil"    # schedutil (fast + saves power) | ondemand | performance | powersave
USB="no"                    # "yes" adds the USB ports (USB disks) to the kernel
KERNEL_BRANCH=""            # empty = Raspberry Pi's current kernel branch (e.g. rpi-6.12.y)
STOCK_KERNEL="yes"          # also put Alpine's stock kernel on the card as a rescue slot

# ------------------------------------------------------------------ Alpine
ALPINE_BRANCH="v3.24"
ALPINE_MIRROR="https://dl-cdn.alpinelinux.org/alpine"
