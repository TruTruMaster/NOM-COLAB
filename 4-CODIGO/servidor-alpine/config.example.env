# servidor-alpine settings. Copy to config.env, edit, then run 1-install.sh.
# Plain sh syntax: NAME="value". Secrets in here (Wi-Fi password, Tailscale
# key) are used during the install and never copied to the server as text.

# ------------------------------------------------------------------ system
SERVER_NAME="nomcolab"
TIMEZONE="America/Mexico_City"
ADMIN_USER="admin"
# Size of the Alpine partition. Empty = the whole disk. Set e.g. "80G" to
# leave the rest free for a second OS (Debian for gaming, see README).
ROOT_SIZE=""

# ------------------------------------------------------------------ SSH
# Public keys allowed to log in as ADMIN_USER, one per line. Keys found by
# 0-prepare.sh in the old system's authorized_keys are added automatically.
# Make one on the device you will connect from:  ssh-keygen -t ed25519
SSH_KEYS="
"

# ------------------------------------------------------------------ network
# Wired Ethernet (eth0, DHCP) is always enabled: a server should use the cable.
# Wi-Fi is optional; leave WIFI_SSID empty to keep the Wi-Fi stack out entirely.
WIFI_SSID=""
WIFI_PSK=""
WIFI_COUNTRY="MX"

# ------------------------------------------------------------------ Tailscale
# Three ways, in order of preference:
#  1. Migration: 0-prepare.sh copied the old tailscaled.state -> same machine
#     name, same 100.x address, same Funnel URL. Nothing to set here.
#  2. TS_AUTHKEY: an auth key from https://login.tailscale.com/admin/settings/keys
#  3. Neither: after the first boot run `doas tailscale up --qr` on the console.
TS_AUTHKEY=""
# Let Tailscale rewrite /etc/resolv.conf (MagicDNS)? "no" keeps the DHCP DNS.
TS_ACCEPT_DNS="no"

# ------------------------------------------------------------------ services
WEB="yes"                 # nginx on :80 serving /srv/www (multi-site, reverse proxy)
NOMCOLAB="yes"            # NOM-COLAB (Java 21) on :8080, data in /srv/nomcolab
NOMCOLAB_AUTOSTART="yes"  # start it at boot (dedicated server) or only with `nomcolab up`
NOMCOLAB_DISCOVERY="true" # announce it on the LAN (UDP 47474) for the Android app

# ------------------------------------------------------------------ laptop as a server
CPU_EPP="balance_power"   # performance | balance_performance | balance_power | power
CONSOLE_BLANK="120"       # seconds until the built-in screen switches off
BATTERY_MIN="10"          # on battery after a power cut: clean poweroff at this %
BATTERY_CHARGE_START="40" # charge window, if the laptop supports it (ThinkPad,
BATTERY_CHARGE_END="80"   # recent Dell); otherwise set it in the BIOS

# ------------------------------------------------------------------ kernel
KSERIES="6.18"            # longterm series used by `kernel-min build`
CONTAINERS="no"           # add what podman/docker need
GAMING="no"               # add sound, input, 32-bit, Wine/Proton needs (README: Gaming)

# ------------------------------------------------------------------ Alpine
ALPINE_MIRROR="https://dl-cdn.alpinelinux.org/alpine"
