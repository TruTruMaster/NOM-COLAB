#!/bin/sh
# Hardware watchdog: if this process stops petting it (kernel hang), the
# chipset reboots the machine after 60 s. A clean stop disarms it.
exec 2>&1
modprobe -q iTCO_wdt 2>/dev/null
if ! [ -c /dev/watchdog ]; then echo "watchdog: no /dev/watchdog, idling"; exec sleep 2147483647; fi
exec watchdog -F -T 60 -t 10 /dev/watchdog
