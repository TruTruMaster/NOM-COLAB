#!/bin/sh
# BCM2712 hardware watchdog: if this process stops petting it (kernel hang),
# the SoC reboots after 15 s (its maximum). A clean stop disarms it.
exec 2>&1
modprobe -q bcm2835_wdt 2>/dev/null
if ! [ -c /dev/watchdog ]; then echo "watchdog: no /dev/watchdog, idling"; exec sleep 2147483647; fi
exec watchdog -F -T 15 -t 5 /dev/watchdog
