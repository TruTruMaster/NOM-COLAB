#!/bin/sh
# CPU frequency policy (default schedutil: 1.5 GHz when idle, 2.4 GHz the
# moment there is work). Value from /etc/servidor-alpine.conf.
. /etc/servidor-alpine.conf
for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
  [ -w "$f" ] && echo "${CPU_GOVERNOR:-schedutil}" 2>/dev/null > "$f"
done
exit 0
