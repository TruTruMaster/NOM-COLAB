#!/bin/sh
# NOM-COLAB server (Spring Boot jar) as user nomcolab, data in /srv/nomcolab/datos.
exec 2>&1
. /etc/servidor-alpine.conf
D=/srv/nomcolab
if ! [ -f "$D/nom-colab.jar" ]; then
  echo "nomcolab: falta $D/nom-colab.jar (cópialo y luego: svc restart nomcolab)"
  exec sleep 2147483647
fi
java=$(command -v java || ls /usr/lib/jvm/*/bin/java 2>/dev/null | head -n1)
cd "$D" || exit 1
export NOM_PUERTO=8080 NOM_DATOS="$D/datos" NOM_DESCUBRIMIENTO="${NOMCOLAB_DISCOVERY:-true}"
exec s6-setuidgid nomcolab "$java" -Xmx512m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError \
  -Djava.awt.headless=true -jar "$D/nom-colab.jar"
