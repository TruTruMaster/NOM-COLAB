#!/bin/sh
# kernel-min - build and boot the stripped kernel safely (A/B with rollback).
#
#   kernel-min build     build for this machine, then `install` it as a trial
#   kernel-min install [linux.efi]
#                        copy to the ESP as \EFI\minimal\linux-new.efi and boot it
#                        ONCE on the next reboot (EFI BootNext). If it hangs or
#                        panics, the next boot is the previous kernel again.
#   kernel-min confirm   after a good trial boot (you could log in over SSH):
#                        make it the default; the old one becomes "previous"
#   kernel-min rollback  boot "previous" once on the next reboot
#   kernel-min status    boot entries, files, running kernel
#   kernel-min drop-stock  remove Alpine's stock kernel, initramfs and firmware
#                        (only once the stripped kernel is confirmed)
set -eu
. /etc/servidor-alpine.conf
SHARE=/usr/local/share/servidor-alpine
WORK=${WORK:-/var/cache/kernel-min}
ESP=/boot
DIR=$ESP/EFI/minimal
L_MAIN="Alpine minimal"
L_PREV="Alpine minimal (previous)"
L_TRIAL="Alpine minimal (trial)"
L_STOCK="Alpine stock (rescue)"

die() { echo "kernel-min: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run it as root: doas kernel-min $*"

mountpoint -q "$ESP" || mount "$ESP" || die "cannot mount the ESP on $ESP"
mountpoint -q /sys/firmware/efi/efivars || mount -t efivarfs efivarfs /sys/firmware/efi/efivars

# ESP partition -> disk + partition number, for efibootmgr
esp_dev=$(awk -v m="$ESP" '$2 == m { print $1 }' /proc/mounts | tail -n1)
esp_name=$(basename "$(readlink -f "$esp_dev")")
ESP_PART=$(cat "/sys/class/block/$esp_name/partition")
ESP_DISK=/dev/$(basename "$(readlink -f "/sys/class/block/$esp_name/..")")

entry() { # entry <label>: boot number of the entry with exactly this label
  efibootmgr | awk -v L="$1" '/^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ {
    lab = $0; sub(/^Boot[0-9A-Fa-f]+[* ] /, "", lab); sub(/\t.*/, "", lab)
    if (lab == L) print substr($0, 5, 4) }' | head -n1
}
order() { efibootmgr | awk '/^BootOrder:/ { print $2 }'; }
create() { # create <label> <file under \EFI\minimal>: entry with no extra arguments
  old=$(order)
  efibootmgr -q -c -d "$ESP_DISK" -p "$ESP_PART" -L "$1" -l "\\EFI\\minimal\\$2"
  [ -n "$old" ] && efibootmgr -q -o "$old"   # efibootmgr puts new entries first: undo that
  entry "$1"
}
delete() { n=$(entry "$1"); [ -z "$n" ] || efibootmgr -q -b "$n" -B; }
ensure() { n=$(entry "$1"); [ -n "$n" ] || n=$(create "$1" "$2"); echo "$n"; }
put_first() { # put_first <num>...: these first, then the rest in their old order
  efibootmgr -q -o "$(order | awk -v first="$*" 'BEGIN { RS = ","; n = split(first, f, " ")
    for (i = 1; i <= n; i++) { out = out (out ? "," : "") f[i]; skip[f[i]] = 1 } }
    { gsub(/\n/, "") } $0 != "" && !($0 in skip) { out = out "," $0 } END { print out }')"
}

cmd_install() {
  img=${1:-$WORK/out/linux.efi}
  [ -f "$img" ] || die "no kernel image $img (run: kernel-min build)"
  mkdir -p "$DIR"
  cp "$img" "$DIR/linux-new.efi.tmp" && sync && mv "$DIR/linux-new.efi.tmp" "$DIR/linux-new.efi"
  n=$(ensure "$L_TRIAL" linux-new.efi)
  # keep the trial entry last in BootOrder so it never becomes the default
  efibootmgr -q -o "$(order | awk -v n="$n" 'BEGIN { RS = "," } { gsub(/\n/, "") }
    $0 != "" && $0 != n { out = out $0 "," } END { print out n }')"
  efibootmgr -q -n "$n"
  echo "kernel-min: trial kernel installed as Boot$n, it boots ONCE on the next reboot."
  echo "  doas reboot           then, once you are back in over SSH:"
  echo "  doas kernel-min confirm"
  echo "If it does not come back within ~2 min, power-cycle it: the previous kernel boots."
}

cmd_confirm() {
  cur=$(efibootmgr | awk '/^BootCurrent:/ { print $2 }')
  trial=$(entry "$L_TRIAL")
  if [ -z "$trial" ] || [ "$cur" != "$trial" ]; then
    die "not running the trial kernel (BootCurrent=$cur, trial=${trial:-none}): nothing to confirm"
  fi
  [ -f "$DIR/linux.efi" ] && mv "$DIR/linux.efi" "$DIR/linux-prev.efi"
  mv "$DIR/linux-new.efi" "$DIR/linux.efi"
  delete "$L_TRIAL"
  main=$(ensure "$L_MAIN" linux.efi)
  prev=""
  [ -f "$DIR/linux-prev.efi" ] && prev=$(ensure "$L_PREV" linux-prev.efi)
  # shellcheck disable=SC2086
  put_first "$main" $prev
  # Firmware fallback path, used by laptops that ignore boot entries; only if
  # nothing else (another OS) put its own loader there.
  fb=$ESP/EFI/BOOT
  if ! [ -f "$fb/BOOTX64.EFI" ] || [ -f "$fb/.servidor-alpine" ]; then
    mkdir -p "$fb" && cp "$DIR/linux.efi" "$fb/BOOTX64.EFI" && : > "$fb/.servidor-alpine"
  fi
  sync
  echo "kernel-min: $(uname -r) is now the default (Boot$main)${prev:+, previous kept as Boot$prev}."
}

cmd_rollback() {
  n=$(entry "$L_PREV"); [ -n "$n" ] || n=$(entry "$L_STOCK")
  [ -n "$n" ] || die "no previous or stock kernel entry"
  efibootmgr -q -n "$n"
  echo "kernel-min: Boot$n boots once on the next reboot (doas reboot)."
}

cmd_status() {
  echo "running:   $(uname -r)  $(uname -v)"
  echo "cmdline:   $(cat /proc/cmdline)"
  echo "ESP:       $ESP_DISK partition $ESP_PART on $ESP"
  ls -l "$DIR" 2>/dev/null | sed 1d
  efibootmgr
}

cmd_drop_stock() {
  [ "$(entry "$L_MAIN")" = "$(efibootmgr | awk '/^BootCurrent:/ { print $2 }')" ] \
    || die "boot and confirm the stripped kernel first (kernel-min status)"
  delete "$L_STOCK"
  pkgs=""
  for p in linux-lts mkinitfs kmod linux-firmware-none linux-firmware-intel linux-firmware-other; do
    if apk info -e "$p" >/dev/null; then pkgs="$pkgs $p"; fi
  done
  # shellcheck disable=SC2086
  [ -z "$pkgs" ] || apk del -q $pkgs
  rm -f "$ESP"/vmlinuz-lts "$ESP"/initramfs-lts "$ESP"/config-lts "$ESP"/System.map-lts
  rm -rf /lib/modules/*-lts
  sync
  echo "kernel-min: stock kernel removed. Rescue from now on: 'Alpine minimal (previous)' or a USB stick."
}

case "${1:-status}" in
  build)
    "$SHARE/kernel/build-kernel.sh"
    cmd_install ;;
  install) shift; cmd_install "$@" ;;
  confirm) cmd_confirm ;;
  rollback) cmd_rollback ;;
  status) cmd_status ;;
  drop-stock) cmd_drop_stock ;;
  *) sed -n '2,17p' "$0"; exit 1 ;;
esac
