#!/bin/sh
# kernel-min - update the stripped Raspberry Pi 5 kernel safely (A/B slots).
#
#   kernel-min status        slots, running kernel, what boots next
#   kernel-min build         build on the Pi (~20 min), then `install`
#   kernel-min install [DIR] put a built kernel (default /var/cache/kernel-min/out)
#                            into the free slot (a/ or b/) and aim [tryboot] at it
#   kernel-min trial         reboot ONCE into that slot. If it hangs or panics,
#                            power-cycle: the default slot boots again
#   kernel-min confirm       after a good trial (you are back in over SSH):
#                            make the running slot the default
#   kernel-min rollback [s]  make the other slot (or s/ = stock) the default
#   kernel-min drop-stock    delete the stock rescue slot s/ and its packages
set -eu
. /etc/servidor-alpine.conf
SHARE=/usr/local/share/servidor-alpine
OUT=/var/cache/kernel-min/out
B=/boot
CFG=$B/config.txt

die() { echo "kernel-min: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || exec doas "$0" "$@"
mountpoint -q "$B" || mount "$B" || die "cannot mount the boot partition on $B"

# os_prefix of a config.txt section: prefix_of <all|tryboot>
prefix_of() { awk -v s="[$1]" '/^\[/ { in_s = ($0 == s) } in_s && /^os_prefix=/ { sub(/^os_prefix=/, ""); sub(/\/$/, ""); print; exit }' "$CFG"; }
set_prefix() { # set_prefix <all|tryboot> <slot>: rewrite atomically (FAT: write copy, then rename)
  awk -v s="[$1]" -v v="$2" '/^\[/ { in_s = ($0 == s) } in_s && /^os_prefix=/ { $0 = "os_prefix=" v "/" } { print }' "$CFG" > "$CFG.new"
  sync; mv "$CFG.new" "$CFG"; sync
}
running() { sed -n 's/.*kmin\.slot=\([a-z]\).*/\1/p' /proc/cmdline; }
cmdline() { echo "root=PARTUUID=$ROOT_PARTUUID rootfstype=ext4 ro rootwait=20 init=/sbin/init console=ttyAMA10,115200 loglevel=4 kmin.slot=$1"; }

cmd_status() {
  echo "running:  $(uname -r), slot $(running)"
  echo "default:  [all] os_prefix=$(prefix_of all)/"
  echo "trial:    [tryboot] os_prefix=$(prefix_of tryboot)/"
  for s in a b s; do
    [ -d "$B/$s" ] && echo "slot $s/:  $(cat "$B/$s/version" 2>/dev/null || echo 'Alpine stock') $(ls -l "$B/$s/kernel_2712.img" | awk '{ print $5 " bytes" }')"
  done
  return 0
}

cmd_install() {
  src=${1:-$OUT}
  [ -f "$src/kernel_2712.img" ] || die "no kernel in $src (kernel-min build)"
  def=$(prefix_of all)
  case "$def" in a) free=b ;; *) free=a ;; esac
  [ "$(running)" != "$free" ] || die "slot $free/ is the one running; confirm or roll back first"
  rm -rf "${B:?}/$free"
  mkdir -p "$B/$free/overlays"
  cp "$src/kernel_2712.img" "$src"/bcm2712*.dtb "$src/version" "$B/$free/"
  cp "$src"/overlays/*.dtbo "$B/$free/overlays/"
  # without this file the firmware ignores $free/overlays/ and uses /overlays/
  echo "Overlays for this kernel slot. The Pi firmware reads <os_prefix>overlays/ only while this README exists; without it, it ignores os_prefix and uses /overlays/." > "$B/$free/overlays/README"
  cmdline "$free" > "$B/$free/cmdline.txt"
  [ -x "$src/rpi-tryboot" ] && install -m 755 "$src/rpi-tryboot" /usr/local/sbin/rpi-tryboot
  set_prefix tryboot "$free"
  sync
  echo "kernel-min: $(cat "$src/version") is in slot $free/. Next:"
  echo "  doas kernel-min trial      (boots it once; power-cycle if it does not come back)"
}

cmd_trial() {
  t=$(prefix_of tryboot)
  [ -f "$B/$t/kernel_2712.img" ] || die "slot $t/ is empty: kernel-min install first"
  [ -x /usr/local/sbin/rpi-tryboot ] || die "missing /usr/local/sbin/rpi-tryboot"
  mkdir -p /var/lib/kernel-min
  : > /var/lib/kernel-min/tryboot      # rc.shutdown.final reboots with "0 tryboot"
  echo "kernel-min: rebooting once into slot $t/ ..."
  exec reboot
}

cmd_confirm() {
  r=$(running); def=$(prefix_of all)
  [ -n "$r" ] || die "cannot tell which slot is running (no kmin.slot= in /proc/cmdline)"
  [ "$r" != "$def" ] || { echo "kernel-min: slot $r/ is already the default"; return 0; }
  set_prefix all "$r"
  set_prefix tryboot "$def"
  echo "kernel-min: slot $r/ ($(uname -r)) is now the default; slot $def/ kept as the way back."
}

cmd_rollback() {
  def=$(prefix_of all)
  to=${1:-}
  if [ -z "$to" ]; then case "$def" in a) to=b ;; b) to=a ;; *) to=a ;; esac; fi
  [ -f "$B/$to/kernel_2712.img" ] || die "slot $to/ has no kernel"
  set_prefix all "$to"
  echo "kernel-min: slot $to/ is the default from the next boot (doas reboot)."
}

cmd_drop_stock() {
  [ "$(running)" != s ] || die "running the stock kernel; boot a stripped slot first"
  [ "$(prefix_of all)" != s ] || die "the stock slot is the default; kernel-min rollback a"
  rm -rf "${B:?}/s" "$B"/vmlinuz-rpi "$B"/initramfs-rpi "$B"/config-rpi "$B"/System.map-rpi
  pkgs=""
  for p in linux-rpi mkinitfs linux-firmware-none linux-firmware-brcm linux-firmware-cypress; do
    if apk info -e "$p" >/dev/null; then pkgs="$pkgs $p"; fi
  done
  sed -i '/^linux-rpi=/d' /etc/apk/world
  # shellcheck disable=SC2086
  [ -z "$pkgs" ] || apk del -q $pkgs
  rm -rf /lib/modules/*-rpi*
  sync
  echo "kernel-min: stock kernel removed. Rescue from now on: the other slot, or the card in another computer."
}

case "${1:-status}" in
  status) cmd_status ;;
  build) "$SHARE/kernel/build-kernel.sh"; cmd_install ;;
  install) shift; cmd_install "$@" ;;
  trial) cmd_trial ;;
  confirm) cmd_confirm ;;
  rollback) shift; cmd_rollback "$@" ;;
  drop-stock) cmd_drop_stock ;;
  *) sed -n '2,15p' "$0"; exit 1 ;;
esac
