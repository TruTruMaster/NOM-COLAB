# Only for test/qemu-boot.sh: serial console for the emulated q35 machine.
# The emulated disk (NVMe), NIC (e1000e), AHCI and TCO watchdog use the real
# laptop drivers from base.config, so the test exercises them.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_LPC_ICH=y
