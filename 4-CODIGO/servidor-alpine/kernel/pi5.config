# Raspberry Pi 5 (BCM2712 + RP1), booting from the microSD slot, wired Ethernet.
# Only what the board needs, taken from its device tree
# (arch/arm64/boot/dts/broadcom/bcm2712-rpi-5-b.dts) and Raspberry Pi's
# bcm2712_defconfig. No display, camera, audio, USB or Wi-Fi here: wifi.config
# and usb.config add those two when config.env asks for them.

# ---------------------------------------------------------------- CPU: 4 x Cortex-A76
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_BRCMSTB=y
# 16K pages, as Raspberry Pi OS uses on the Pi 5: fewer TLB misses, faster
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_47=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_SCHED_MC=y
# Fake NUMA nodes spread allocations over the SDRAM banks (Raspberry Pi's tuning)
CONFIG_NUMA=y
CONFIG_NUMA_EMU=y
# Raspberry Pi's NUMA emulation calls into CMA (and the Pi 5 DT reserves a CMA pool)
CONFIG_CMA=y
# These four are always on in 7.x; on 6.x they exist and allnoconfig would drop them
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_USE_LSE_ATOMICS=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_RAS_EXTN=y
CONFIG_ARM64_CNP=y
# Hardware-managed access/dirty bits (ARMv8.1): fewer page faults
CONFIG_ARM64_HW_AFDBM=y
# Timer event stream: user-space spin loops sleep in WFE instead of burning power
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
# Cortex-A76 errata and Spectre-BHB (allnoconfig turns them off)
CONFIG_ARM64_ERRATUM_1165522=y
CONFIG_ARM64_ERRATUM_1286807=y
CONFIG_ARM64_ERRATUM_1463225=y
CONFIG_ARM64_ERRATUM_3194386=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_RODATA_FULL_DEFAULT_ENABLED=y

# ---------------------------------------------------------------- firmware interface, clocks, power
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_COMMON_CLK=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_RASPBERRYPI=y
CONFIG_RESET_BRCMSTB=y
CONFIG_RESET_BRCMSTB_RESCAL=y
CONFIG_BRCMSTB_L2_IRQ=y
CONFIG_BCM2712_MIP=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_BRCMSTB=y
CONFIG_PINCTRL_BCM2712=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_BRCMSTB=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y

# ---------------------------------------------------------------- microSD (sdio1, UHS-I SDR104)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_BRCMSTB=y

# ---------------------------------------------------------------- RP1 (PCIe southbridge): Ethernet, fan PWM
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_POWERSAVE=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_MFD_RP1=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_PINCTRL_RP1=y
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y
CONFIG_PHYLIB=y
CONFIG_BROADCOM_PHY=y
CONFIG_PWM=y
CONFIG_PWM_RP1=y
CONFIG_SENSORS_PWM_FAN=y

# ---------------------------------------------------------------- CPU speed, temperature, power supply
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y
CONFIG_MFD_SYSCON=y
CONFIG_BCM2711_THERMAL=y
# Undervoltage warnings from the firmware (a weak power supply shows up here)
CONFIG_SENSORS_RASPBERRYPI_HWMON=y

# ---------------------------------------------------------------- RTC, watchdog, RNG, debug UART, LED
# rtc-rpi sits inside the I2C menu in Raspberry Pi's tree (no I2C bus driver needed)
CONFIG_I2C=y
CONFIG_RTC_DRV_RPI=y
CONFIG_BCM2835_WDT=y
CONFIG_HW_RANDOM_IPROC_RNG200=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
