# Intel Wi-Fi (AX201/AX200/9560 and older iwlmvm cards). Only added when
# config.env sets WIFI_SSID. Firmware + regulatory.db are embedded by build-kernel.sh.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_MAC80211_RC_MINSTREL=y
