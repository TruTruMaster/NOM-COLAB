# NOM-COLAB en esta computadora. No arranca solo: se prende y se apaga con `nomcolab`
# (Local -> Prender / Apagar). %h = la carpeta de inicio del usuario.
[Unit]
Description=NOM-COLAB (servidor propio, publicado por Tailscale Funnel)
After=network-online.target

[Service]
WorkingDirectory=%h/nomcolab-servidor
Environment=NOM_PUERTO=8080
Environment=NOM_DATOS=%h/nomcolab-servidor/datos
ExecStart=%h/NOM/2-PAGINA-Servidor/java-linux/bin/java -Xmx512m -jar %h/nomcolab-servidor/nom-colab.jar
Restart=on-failure
RestartSec=5
