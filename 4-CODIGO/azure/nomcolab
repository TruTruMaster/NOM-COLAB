#!/usr/bin/env bash
# nomcolab - control the NOM-COLAB deployment on Azure (web app + database).
#
#   nomcolab --up      allow DB network access, start the web app, wake web and DB
#   nomcolab --down    stop the web app, deny DB network access (DB auto-pauses when idle)
#   nomcolab --state   report web app and database status
#   nomcolab --reset   full cycle: --down followed by --up
#
# Web app : nomcolab-wack (App Service, plan F1 Free, Linux, Java 21)  rg-nomcolab / westus
# Database: nomcolab on server nomcolab-sql-6a073f.database.windows.net
#           (Azure SQL Database, serverless GP_S_Gen5_1, free offer)  rg-nomcolab / westus
# All operations stay within free tiers.

URL="https://nomcolab-wack.azurewebsites.net"
RG="rg-nomcolab"; APP="nomcolab-wack"; PLAN="plan-nomcolab"; SQL="nomcolab-sql-6a073f"; DB="nomcolab"

T0=$(date +%s.%N)
ERR=0
log() { printf '[%12.6f] %s\n' "$(echo "$(date +%s.%N) - $T0" | bc)" "$*"; }
err() { ERR=$((ERR + 1)); log "$*"; }

TMP=$(mktemp); trap 'rm -f "$TMP" "$TMP.err"' EXIT

# Runs an az command; logs its error output on failure. Usage: azc <subsystem> <description> az args...
azc() {
  local sub="$1" what="$2"; shift 2
  if az "$@" >"$TMP" 2>"$TMP.err"; then return 0; fi
  err "$sub: $what failed: $(grep -v '^WARNING' "$TMP.err" | head -1 | cut -c1-160)"
  return 1
}

need_az() {
  if ! command -v az >/dev/null 2>&1; then err "az: Azure CLI not installed (pipx install azure-cli)"; finish; fi
  if ! az account show -o none 2>/dev/null; then err "az: not logged in (az login --use-device-code)"; finish; fi
  log "az: subscription '$(az account show --query name -o tsv 2>/dev/null)' user $(az account show --query user.name -o tsv 2>/dev/null)"
}

finish() {
  if [ "$ERR" -eq 0 ]; then log "nomcolab: $ACTION completed, 0 errors"; exit 0; fi
  log "nomcolab: $ACTION finished with $ERR error(s)"; exit 1
}

# HTTP probe. Prints "<code> <seconds>".
probe() { curl -s -o "$TMP" -w '%{http_code} %{time_total}' --max-time "${2:-60}" "$URL$1"; }
# A login with a non-existent user forces a DB query: 401 = DB answered, 5xx/000 = DB not reachable.
probe_db() { curl -s -o /dev/null -w '%{http_code} %{time_total}' --max-time 90 -H 'Content-Type: application/json' \
               -X POST "$URL/api/cuentas/sesion" -d '{"nombre":"nomcolab-probe","contrasena":"x"}'; }
quota_hit() { [ "$1" = "403" ] && grep -qi "disabled\|quota" "$TMP" 2>/dev/null; }

web_state() { az webapp show -g "$RG" -n "$APP" --query state -o tsv 2>/dev/null; }
db_status() { az sql db show -g "$RG" -s "$SQL" -n "$DB" --query status -o tsv 2>/dev/null; }
db_network() { az sql server show -g "$RG" -n "$SQL" --query publicNetworkAccess -o tsv 2>/dev/null; }

report_web() {
  local s; s=$(az webapp show -g "$RG" -n "$APP" --query "[state, defaultHostName, location, siteConfig.linuxFxVersion, httpsOnly]" -o tsv 2>/dev/null | tr '\n' '\t')
  local sku; sku=$(az appservice plan show -g "$RG" -n "$PLAN" --query "sku.name" -o tsv 2>/dev/null)
  IFS=$'\t' read -r st host loc rt https <<<"$s"
  log "web: app $APP state=${st:-unknown} host=$host region=\"$loc\" plan=$PLAN sku=$sku runtime=${rt:-JAVA|21} https_only=$https"
}

report_db() {
  local s; s=$(az sql db show -g "$RG" -s "$SQL" -n "$DB" --query "[status, currentServiceObjectiveName, location, autoPauseDelay, maxSizeBytes, useFreeLimit, freeLimitExhaustionBehavior]" -o tsv 2>/dev/null | tr '\n' '\t')
  IFS=$'\t' read -r st sku loc ap max free ex <<<"$s"
  log "db: server $SQL.database.windows.net database=$DB status=${st:-unknown} sku=$sku region=$loc"
  log "db: auto_pause=${ap}min max_size=$((max / 1073741824))GB free_offer=$free on_exhaustion=$ex public_network=$(db_network)"
  local id rem; id=$(az sql db show -g "$RG" -s "$SQL" -n "$DB" --query id -o tsv 2>/dev/null)
  rem=$(az monitor metrics list --resource "$id" --metric free_amount_remaining --interval PT1H \
         --query "value[0].timeseries[0].data[-1].minimum" -o tsv 2>/dev/null)
  [ -n "$rem" ] && [ "$rem" != "None" ] && log "db: free allowance remaining this month: ${rem%.*}/100000 vCore-seconds"
}

wake_web() {
  log "web: probing $URL/api/red/info"
  local r c t i
  for i in 1 2 3 4 5 6 7 8; do
    r=$(probe /api/red/info 60); c=${r%% *}; t=${r##* }
    if [ "$c" = "200" ]; then log "web: HTTP 200 in ${t}s, app responding"; return 0; fi
    if quota_hit "$c"; then err "web: HTTP 403 site disabled, F1 daily CPU quota (60 min) exhausted; resets 00:00 UTC"; return 1; fi
    log "web: HTTP $c after ${t}s (attempt $i/8), retrying in 10s"
    sleep 10
  done
  err "web: not responding after 8 attempts"; return 1
}

wake_db() {
  log "db: opening a connection through the app (login probe)"
  local r c t i
  for i in 1 2 3 4 5 6; do
    r=$(probe_db); c=${r%% *}; t=${r##* }
    if [ "$c" = "401" ]; then log "db: query answered in ${t}s, database online"; return 0; fi
    log "db: probe returned HTTP $c after ${t}s (attempt $i/6, resuming), retrying in 15s"
    sleep 15
  done
  err "db: not reachable after 6 attempts (status=$(db_status))"; return 1
}

do_up() {
  if [ "$(db_network)" != "Enabled" ]; then
    log "db: public network access Disabled -> Enabled"
    azc db "enable network access" sql server update -g "$RG" -n "$SQL" --enable-public-network true -o none && log "db: network access enabled"
  else
    log "db: public network access already Enabled"
  fi
  local st; st=$(web_state)
  if [ "$st" != "Running" ]; then
    log "web: state ${st:-unknown} -> Running"
    azc web "start" webapp start -g "$RG" -n "$APP" -o none && log "web: start issued"
  else
    log "web: state already Running"
  fi
  wake_web && wake_db
  log "web: state=$(web_state)"; log "db: status=$(db_status)"
}

do_down() {
  local st; st=$(web_state)
  if [ "$st" != "Stopped" ]; then
    log "web: state ${st:-unknown} -> Stopped"
    azc web "stop" webapp stop -g "$RG" -n "$APP" -o none && log "web: stop issued, state=$(web_state)"
  else
    log "web: state already Stopped"
  fi
  if [ "$(db_network)" != "Disabled" ]; then
    log "db: public network access Enabled -> Disabled (drops all client connections)"
    azc db "disable network access" sql server update -g "$RG" -n "$SQL" --enable-public-network false -o none && log "db: network access disabled"
  else
    log "db: public network access already Disabled"
  fi
  log "db: status=$(db_status); serverless has no manual pause, auto-pause after $(az sql db show -g "$RG" -s "$SQL" -n "$DB" --query autoPauseDelay -o tsv 2>/dev/null) min without connections"
}

do_state() {
  report_web
  local st; st=$(web_state)
  if [ "$st" = "Running" ]; then
    local r c t; r=$(probe /api/red/info 10); c=${r%% *}; t=${r##* }
    if [ "$c" = "200" ]; then log "web: HTTP 200 in ${t}s (awake)"
    elif quota_hit "$c"; then log "web: HTTP 403 site disabled (F1 daily CPU quota exhausted)"
    else log "web: HTTP $c after ${t}s (asleep or starting)"; fi
  fi
  report_db
}

ACTION="${1#--}"
log "nomcolab: ${ACTION:-help} started at $(date +%Y-%m-%dT%H:%M:%S.%3N%:z) on $(hostname)"
case "$1" in
  --up)    need_az; do_up ;;
  --down)  need_az; do_down ;;
  --state) need_az; do_state ;;
  --reset) need_az; log "nomcolab: phase 1/2 down"; do_down; log "nomcolab: phase 2/2 up"; do_up ;;
  *)       sed -n 2,13p "$0" | sed 's/^# \{0,1\}//'; [ -n "$1" ] && { err "nomcolab: unknown option '$1'"; }; ACTION=help ;;
esac
finish
