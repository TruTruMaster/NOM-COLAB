@startuml 08-cu-cuentas
title Casos de uso - Módulo Gestión de cuentas
skinparam shadowing false
left to right direction

actor "Visitante" as V
actor "Usuario" as U
actor "Módulo de\nseguridad" as S <<sistema>>
U -up-|> V

rectangle "Gestión de cuentas" {
  usecase "CU-01\nCrear usuario" as CU01
  usecase "CU-02\nIniciar sesión" as CU02
  usecase "CU-03\nCerrar sesión" as CU03
  usecase "CU-04\nBloquear acceso\npor intentos fallidos" as CU04
  usecase "CU-05\nCifrar credenciales" as CU05
  usecase "CU-27\nConfigurar\npreferencias" as CU27
}

V --> CU01
V --> CU02
U --> CU03
U --> CU27
CU01 ..> CU05 : <<include>>
CU02 ..> CU05 : <<include>>
CU04 ..> CU02 : <<extend>>
CU04 -- S
CU05 -- S
@enduml
