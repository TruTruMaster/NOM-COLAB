@startuml 03-flujo-cuentas
title Flujo 1 - Registro e inicio de sesion
skinparam shadowing false
start
:Abrir NOM-COLAB;
if (Tiene cuenta?) then (no)
  :Capturar nombre y contrasena;
  :Capturar empresa (opcional);
  if (Nombre disponible?) then (no)
    :Mostrar "nombre ya usado";
    stop
  else (si)
  endif
  :Cifrar contrasena (hash);
  :Guardar Usuario;
else (si)
endif
:Capturar credenciales;
if (Credenciales validas?) then (no)
  :intentosFallidos + 1;
  if (intentosFallidos > 5?) then (si)
    :Bloquear acceso;
    stop
  else (no)
  endif
  :Reintentar;
  stop
else (si)
endif
:Crear Sesion (token);
:Cargar lista de Espacios del usuario;
:Ir a pantalla Inicio;
stop
@enduml
